<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationIcon>Resources\monkasa.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Resources\**" />
    <Compile Remove="Monkasa.Tests/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="NLog.config" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <MacNativeLibrary>$(IntermediateOutputPath)native/libMonkasa.Platform.Mac.dylib</MacNativeLibrary>
  </PropertyGroup>

  <Target Name="BuildMacThumbnailBridge"
          BeforeTargets="CoreCompile"
          Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <MakeDir Directories="$(IntermediateOutputPath)native" />
    <Exec Command="xcrun clang -dynamiclib -fobjc-arc -mmacosx-version-min=11.0 -framework Foundation -framework AppKit -framework QuickLookThumbnailing -o &quot;$(MacNativeLibrary)&quot; &quot;$(MSBuildProjectDirectory)/Native/Mac/MonkasaThumbnailBridge.m&quot;" />
  </Target>

  <Target Name="CopyMacThumbnailBridgeToBuildOutput"
          AfterTargets="Build"
          DependsOnTargets="BuildMacThumbnailBridge"
          Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <Copy SourceFiles="$(MacNativeLibrary)" DestinationFolder="$(TargetDir)" />
  </Target>

  <Target Name="CopyMacThumbnailBridgeToPublishOutput"
          AfterTargets="Publish"
          DependsOnTargets="BuildMacThumbnailBridge"
          Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <Copy SourceFiles="$(MacNativeLibrary)" DestinationFolder="$(PublishDir)" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageReference Include="NLog.Extensions.Logging" Version="6.2.0" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageReference Include="SkiaSharp" Version="4.151.1" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.95.0" />
    <!--Condition below is needed to remove Avalonia.Diagnostics package from build output in Release configuration.-->
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.20">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>
</Project>
